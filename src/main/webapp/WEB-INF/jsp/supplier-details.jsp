<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${supplier.supplierName} | PageCraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/supplier.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"></head>
<body><nav class="app-nav"><a class="brand" href="${pageContext.request.contextPath}/suppliers"><span class="brand-mark">▣</span>PageCraft <small>Store</small></a><div class="nav-links"><a class="nav-link active" href="${pageContext.request.contextPath}/suppliers">▤ Suppliers</a><a class="nav-link" href="${pageContext.request.contextPath}/suppliers/new">⊕ New supplier</a></div></nav>
<main class="page-shell"><p style="margin:0 0 18px;color:#66758a;font-size:13px"><a href="${pageContext.request.contextPath}/suppliers">← Back to supplier registry</a></p><section class="panel detail-panel"><header class="detail-top"><div><span class="eyebrow">SUPPLIER PROFILE</span><h1>${supplier.supplierName}</h1><p class="subtitle">${supplier.supplierCategory} · ${supplier.companyName}</p></div><span class="detail-id">${supplier.supplierId}</span></header><div class="detail-grid"><div class="detail-item"><span class="detail-label">Phone number</span><span class="detail-value">${supplier.phoneNumber}</span></div><div class="detail-item"><span class="detail-label">Email address</span><span class="detail-value">${supplier.emailAddress}</span></div><div class="detail-item"><span class="detail-label">Company</span><span class="detail-value">${supplier.companyName}</span></div><div class="detail-item"><span class="detail-label">Registration date</span><span class="detail-value mono">${supplier.registrationDate}</span></div><div class="detail-item"><span class="detail-label">Tax registration</span><span class="detail-value">${supplier.taxRegistrationDetails}</span></div><div class="detail-item"><span class="detail-label">Storage reference</span><span class="detail-value mono">data/suppliers.txt</span></div></div><div class="detail-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/suppliers/edit/${supplier.supplierId}">✎ Edit supplier</a><a class="action action-delete" href="${pageContext.request.contextPath}/suppliers/delete/${supplier.supplierId}" onclick="return confirm('Delete this supplier?')">▥ Delete supplier</a></div></section></main></body></html>
