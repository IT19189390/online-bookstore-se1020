<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Supplier registry | PageCraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/supplier.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"></head>
<body><nav class="app-nav"><a class="brand" href="${pageContext.request.contextPath}/suppliers"><span class="brand-mark">▣</span>PageCraft <small>Store</small></a><div class="nav-links"><a class="nav-link active" href="${pageContext.request.contextPath}/suppliers">▤ Suppliers</a><a class="nav-link" href="${pageContext.request.contextPath}/suppliers/new">⊕ New supplier</a></div></nav>
<main class="page-shell"><header class="page-header"><div><span class="eyebrow">SUPPLIER LEDGER</span><h1>Supplier registry</h1><p class="subtitle">A clear view of every local and international book partner in the network.</p></div><a class="primary-button" href="${pageContext.request.contextPath}/suppliers/new">＋ Add supplier</a></header>
<section class="panel"><div class="toolbar"><form class="search-form" method="get" action="${pageContext.request.contextPath}/suppliers"><input class="search-input" type="search" name="search" value="${param.search}" placeholder="Search name or company"><button class="search-button" type="submit">Search</button></form><span class="mono" style="color:#718096;font-size:11px">SYNCED FILE LEDGER</span></div>
<div class="table-wrap"><table><thead><tr><th>Supplier ID</th><th>Supplier</th><th>Type</th><th>Contact</th><th>Registered</th><th>Actions</th></tr></thead><tbody><c:choose><c:when test="${empty suppliers}"><tr><td colspan="6" style="text-align:center;padding:38px;color:#718096">No suppliers match this search.</td></tr></c:when><c:otherwise><c:forEach var="supplier" items="${suppliers}"><tr><td class="id mono">${supplier.supplierId}</td><td><div class="supplier-cell"><span class="avatar">${supplier.supplierName.substring(0,1)}</span><div><div class="supplier-name">${supplier.supplierName}</div><div class="company">${supplier.companyName}</div></div></div></td><td><span class="badge ${supplier.supplierCategory.startsWith('International') ? 'badge-international' : 'badge-local'}">● ${supplier.supplierCategory}</span></td><td class="contact">${supplier.phoneNumber}<br>${supplier.emailAddress}</td><td class="mono">${supplier.registrationDate}</td><td><div class="actions"><a class="action action-view" href="${pageContext.request.contextPath}/suppliers/details/${supplier.supplierId}">◉ View</a><a class="action action-edit" href="${pageContext.request.contextPath}/suppliers/edit/${supplier.supplierId}">✎ Edit</a><a class="action action-delete" href="${pageContext.request.contextPath}/suppliers/delete/${supplier.supplierId}" onclick="return confirm('Delete this supplier?')">▥ Delete</a></div></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></div>
<footer class="panel-footer"><span>Showing <strong>${suppliers.size()}</strong> stored supplier record(s)</span><span>▣ Thread-safe synchronized file I/O</span></footer></section></main></body></html>
