<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${isEdit ? 'Edit' : 'Add'} supplier | PageCraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/supplier.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"></head>
<body><nav class="app-nav"><a class="brand" href="${pageContext.request.contextPath}/suppliers"><span class="brand-mark">▣</span>PageCraft <small>Store</small></a><div class="nav-links"><a class="nav-link" href="${pageContext.request.contextPath}/suppliers">▤ Suppliers</a><a class="nav-link active" href="${pageContext.request.contextPath}/suppliers/new">⊕ New supplier</a></div></nav>
<main class="page-shell"><section class="panel form-panel"><header class="form-heading"><span class="eyebrow">${isEdit ? 'RECORD UPDATE' : 'SUPPLIER INTAKE'}</span><h1>${isEdit ? 'Modify supplier record' : 'Add a supplier'}</h1><p class="subtitle">Capture the registration and contact details used by the bookstore ledger.</p></header><div class="form-body"><form method="post" action="${pageContext.request.contextPath}/suppliers/${isEdit ? 'update' : 'save'}"><c:if test="${isEdit}"><input type="hidden" name="supplierId" value="${supplier.supplierId}"></c:if><div class="form-grid"><div class="field"><label for="supplierName">Supplier name</label><input id="supplierName" name="supplierName" required value="${supplier.supplierName}" placeholder="e.g. Northstar Books"></div><div class="field"><label for="companyName">Company name</label><input id="companyName" name="companyName" required value="${supplier.companyName}" placeholder="Registered company name"></div><div class="field"><label for="phoneNumber">Phone number</label><input id="phoneNumber" name="phoneNumber" required value="${supplier.phoneNumber}" placeholder="+1 (000) 000-0000"></div><div class="field"><label for="emailAddress">Email address</label><input id="emailAddress" type="email" name="emailAddress" required value="${supplier.emailAddress}" placeholder="contact@company.com"></div><div class="field"><label for="registrationDate">Registration date</label><input id="registrationDate" type="date" name="registrationDate" required value="${supplier.registrationDate}"></div><div class="field"><label for="supplierType">Supplier type</label><select id="supplierType" name="supplierType" onchange="toggleFields()"><option value="LOCAL" ${supplierType == 'LOCAL' ? 'selected' : ''}>Local supplier</option><option value="INTERNATIONAL" ${supplierType == 'INTERNATIONAL' ? 'selected' : ''}>International supplier</option></select></div><div class="field" id="localField"><label for="businessRegNumber">Business registration number</label><input id="businessRegNumber" name="businessRegNumber" value="${supplier.businessRegNumber}" placeholder="State registration number"></div><div class="field" id="internationalField"><label for="country">Country</label><input id="country" name="country" value="${supplier.country}" placeholder="Country of registration"></div><div class="field" id="customsField"><label for="customsCode">Customs code</label><input id="customsCode" name="customsCode" value="${supplier.customsCode}" placeholder="Import customs code"></div></div><div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/suppliers">Cancel</a><button class="primary-button" type="submit">${isEdit ? 'Update supplier' : 'Save supplier'} →</button></div></form></div></section></main>
<script>function toggleFields(){const international=document.getElementById('supplierType').value==='INTERNATIONAL';const businessRegNumber=document.getElementById('businessRegNumber');const country=document.getElementById('country');const customsCode=document.getElementById('customsCode');document.getElementById('localField').style.display=international?'none':'block';document.getElementById('internationalField').style.display=international?'block':'none';document.getElementById('customsField').style.display=international?'block':'none';businessRegNumber.disabled=international;businessRegNumber.required=!international;country.disabled=!international;country.required=international;customsCode.disabled=!international;customsCode.required=international}toggleFields();</script></body></html>
